# Conexión a PostgreSQL (en Railway: agrega un servicio PostgreSQL y enlaza DATABASE_URL).
# Sin esta variable se usa una base en memoria y las cuentas se pierden al reiniciar.
DATABASE_URL=

# Secreto largo y aleatorio: firma las sesiones y cifra las API keys guardadas.
# Generarlo:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si cambia, todos tendrán que iniciar sesión y volver a guardar su API key.
APP_SECRET=

# Código de clase: se pide al crear una cuenta (recomendado si la página es pública).
ACCESS_CODE=

# Opcional: clave de Groq del servidor, usada solo por quien aún no guardó la suya.
GROQ_API_KEY=

# Puerto (Railway lo asigna solo)
PORT=3000
